// SMS through Termii (https://termii.com).
//
// Programs ask for `cap sms.termii.send(only: [...], uses: N)` and call
// `texts.send(phone, text)`. The operator grants the library its HTTP capability, the
// API key and an approved sender ID under `needs`. `only` lists phone numbers in the
// form `canonical` gives: international, without '+', spaces or dashes.

type Sms { to: Text, from: Text, sms: Text, type: Text, channel: Text, api_key: Text }
type Reply { message_id: Text }

capability sms.termii {
    needs http: cap net.http.post(only: ["https://api.ng.termii.com/api/sms/send"])
    needs key: Secret
    needs sender: Text

    canonical(phone: Text) -> Text {
        return number(phone)
    }

    action send(to: Text @target, text: Text) -> Text {
        let sms = Sms { to: number(to), from: sender, sms: text, type: "plain", channel: "generic", api_key: "{secret}" }
        let r = http.post("https://api.ng.termii.com/api/sms/send", fill_secret(json(sms), key),
                          [header("Content-Type", "application/json")])
        if r.status != 200 or not r.complete {
            fail("Termii answered " + json(r.status) + ": " + r.body)
        }
        let reply: Reply = validate parse(Reply, r.body)
        return reply.message_id
    }
}

fn number(phone: Text) -> Text {
    return replace(replace(replace(trim(phone), " ", ""), "-", ""), "+", "")
}
