{
  "about": "A text within the grant is sent once, form-encoded, with the encoded credentials as Basic authentication and the numbers in E.164.",
  "service": "https://api.twilio.com",
  "routes": [
    {
      "method": "POST",
      "path": "/2010-04-01/Accounts/AC_TEST_ACCOUNT/Messages.json",
      "status": 201,
      "body": {
        "sid": "SM{n}",
        "status": "queued",
        "error_code": null,
        "error_message": null
      }
    }
  ],
  "program": "import messaging.twilio\n\nfn main(phone: Text, texts: cap messaging.twilio.sms(uses: 1)) -> Receipt {\n    return texts.sms(phone, \"Your order has shipped.\")\n}\n",
  "inputs": {
    "phone": "+234 (801) 234-5678"
  },
  "grants": {
    "texts": {
      "cap": "messaging.twilio.sms",
      "only": [
        "+234*"
      ],
      "needs": {
        "http": {
          "cap": "net.http.post",
          "only": [
            "{service}/2010-04-01/Accounts/AC_TEST_ACCOUNT/Messages.json"
          ]
        },
        "key": {
          "env": "STAAL_PACKAGE_KEY"
        },
        "account": "AC_TEST_ACCOUNT",
        "from": "+1 415 555 0100"
      }
    }
  },
  "expect": {
    "result": {
      "receipt": "SM1",
      "capability": "messaging.twilio.sms",
      "method": "sms"
    },
    "requests": [
      {
        "method": "POST",
        "path": "/2010-04-01/Accounts/AC_TEST_ACCOUNT/Messages.json",
        "form": {
          "To": "+2348012345678",
          "From": "+14155550100",
          "Body": "Your order has shipped."
        },
        "headers": {
          "Authorization": "Basic {key}",
          "Content-Type": "application/x-www-form-urlencoded"
        }
      }
    ]
  }
}
