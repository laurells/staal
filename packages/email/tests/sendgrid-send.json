{
  "about": "An email within the grant is sent once, as SendGrid's v3 Mail Send documents it, with the key as a Bearer token.",
  "service": "https://api.sendgrid.com",
  "routes": [
    {
      "method": "POST",
      "path": "/v3/mail/send",
      "status": 202,
      "body": ""
    }
  ],
  "program": "import email.sendgrid\n\nfn main(mail: cap email.sendgrid.send(uses: 1)) -> Receipt {\n    return mail.send(\" ada@clinic.org \", \"Results\", \"Your results are ready.\")\n}\n",
  "grants": {
    "mail": {
      "cap": "email.sendgrid.send",
      "only": [
        "*@clinic.org"
      ],
      "needs": {
        "http": {
          "cap": "net.http.post",
          "only": [
            "{service}/v3/mail/send"
          ]
        },
        "key": {
          "env": "STAAL_PACKAGE_KEY"
        },
        "sender": "results@clinic.org"
      }
    }
  },
  "expect": {
    "result": {
      "receipt": "accepted for ada@clinic.org",
      "capability": "email.sendgrid.send",
      "method": "send"
    },
    "requests": [
      {
        "method": "POST",
        "path": "/v3/mail/send",
        "json": {
          "personalizations": [
            {
              "to": [
                {
                  "email": "ada@clinic.org"
                }
              ]
            }
          ],
          "from": {
            "email": "results@clinic.org"
          },
          "subject": "Results",
          "content": [
            {
              "type": "text/plain",
              "value": "Your results are ready."
            }
          ]
        },
        "headers": {
          "Authorization": "Bearer {key}",
          "Content-Type": "application/json"
        }
      }
    ]
  }
}
