{
  "about": "An email to an address outside `only` is refused before any request is made.",
  "service": "https://api.sendgrid.com",
  "routes": [
    {
      "method": "POST",
      "path": "/v3/mail/send",
      "status": 202,
      "body": ""
    }
  ],
  "program": "import email.sendgrid\n\nfn main(mail: cap email.sendgrid.send) -> Receipt {\n    return mail.send(\"eve@elsewhere.com\", \"Results\", \"Your results are ready.\")\n}\n",
  "grants": {
    "mail": {
      "cap": "email.sendgrid.send",
      "only": [
        "*@clinic.org"
      ],
      "needs": {
        "http": {
          "cap": "net.http.post",
          "only": [
            "{service}/v3/mail/send"
          ]
        },
        "key": {
          "env": "STAAL_PACKAGE_KEY"
        },
        "sender": "results@clinic.org"
      }
    }
  },
  "expect": {
    "failure": {
      "kind": "capability",
      "message": "this action targets \"eve@elsewhere.com\""
    },
    "requests": []
  }
}
