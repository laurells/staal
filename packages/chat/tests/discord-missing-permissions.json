{
  "about": "Discord's 403 (JSON error code 50013) for a bot without permission in the channel fails the action with Discord's answer.",
  "service": "https://discord.com",
  "routes": [
    {
      "method": "POST",
      "path": "/api/v10/channels/*/messages",
      "status": 403,
      "body": {
        "message": "You lack permissions to perform that action",
        "code": 50013
      }
    }
  ],
  "program": "import chat.discord\n\nfn main(chat: cap chat.discord.post) -> Receipt {\n    return chat.post(\"1234567890123456789\", \"Deploy finished.\")\n}\n",
  "grants": {
    "chat": {
      "cap": "chat.discord.post",
      "only": [
        "1234567890123456789"
      ],
      "needs": {
        "http": {
          "cap": "net.http.post",
          "only": [
            "{service}/api/v10/channels/*/messages"
          ]
        },
        "token": {
          "env": "STAAL_PACKAGE_KEY"
        }
      }
    }
  },
  "expect": {
    "failure": {
      "kind": "action",
      "message": "Discord answered 403"
    },
    "requests": [
      {
        "method": "POST",
        "path": "/api/v10/channels/1234567890123456789/messages"
      }
    ]
  }
}
