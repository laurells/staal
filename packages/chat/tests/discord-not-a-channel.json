{
  "about": "A channel id that is not a snowflake's digits is refused before any request is made, so no text can change the URL.",
  "service": "https://discord.com",
  "routes": [
    {
      "method": "POST",
      "path": "/api/v10/channels/*/messages",
      "status": 200,
      "body": {
        "id": "11000000000000000{n}",
        "channel_id": "1234567890123456789",
        "content": "Deploy finished.",
        "type": 0
      }
    }
  ],
  "program": "import chat.discord\n\nfn main(chat: cap chat.discord.post) -> Receipt {\n    return chat.post(\"123/../../users/@me\", \"Deploy finished.\")\n}\n",
  "grants": {
    "chat": {
      "cap": "chat.discord.post",
      "only": [
        "1234567890123456789"
      ],
      "needs": {
        "http": {
          "cap": "net.http.post",
          "only": [
            "{service}/api/v10/channels/*/messages"
          ]
        },
        "token": {
          "env": "STAAL_PACKAGE_KEY"
        }
      }
    }
  },
  "expect": {
    "failure": {
      "kind": "capability",
      "message": "is not a Discord channel id"
    },
    "requests": []
  }
}
