{
  "about": "An issue is created in a repository the grant allows.",
  "service": "https://api.github.com",
  "routes": [
    {
      "method": "POST",
      "path": "/repos/teamozy/app/issues",
      "status": 201,
      "body": {
        "number": 42,
        "html_url": "https://github.com/teamozy/app/issues/42"
      }
    }
  ],
  "program": "import code.github\n\nfn main(gh: cap code.github.create_issue(uses: 1)) -> Receipt {\n    return gh.create_issue(\"teamozy/app\", \"Refunds over the limit\", \"Three refunds were refused today.\")\n}\n",
  "grants": {
    "gh": {
      "cap": "code.github.create_issue",
      "only": [
        "teamozy/app"
      ],
      "needs": {
        "get": {
          "cap": "net.http.get",
          "only": [
            "{service}/repos/teamozy/app/*"
          ]
        },
        "post": {
          "cap": "net.http.post",
          "only": [
            "{service}/repos/teamozy/app/*"
          ]
        },
        "token": {
          "env": "STAAL_PACKAGE_KEY"
        }
      }
    }
  },
  "expect": {
    "result": {
      "receipt": "https://github.com/teamozy/app/issues/42",
      "capability": "code.github.create_issue",
      "method": "create_issue"
    },
    "requests": [
      {
        "method": "POST",
        "path": "/repos/teamozy/app/issues",
        "json": {
          "title": "Refunds over the limit",
          "body": "Three refunds were refused today."
        },
        "headers": {
          "Authorization": "Bearer {key}",
          "Accept": "application/vnd.github+json",
          "X-GitHub-Api-Version": "2026-03-10",
          "User-Agent": "staal-code-github"
        }
      }
    ]
  }
}
