{
  "about": "A target that is not owner/repo#number is refused before any request.",
  "service": "https://api.github.com",
  "routes": [
    {
      "method": "POST",
      "path": "/repos/teamozy/app/issues/*/comments",
      "status": 201,
      "body": {
        "id": "{n}",
        "html_url": "https://github.com/teamozy/app/issues/12#issuecomment-{n}"
      }
    }
  ],
  "program": "import code.github\n\nfn main(gh: cap code.github.comment) -> Receipt {\n    return gh.comment(\"teamozy/app/../other#1\", \"hello\")\n}\n",
  "grants": {
    "gh": {
      "cap": "code.github.comment",
      "only": [
        "*"
      ],
      "needs": {
        "get": {
          "cap": "net.http.get",
          "only": [
            "{service}/repos/teamozy/app/*"
          ]
        },
        "post": {
          "cap": "net.http.post",
          "only": [
            "{service}/repos/teamozy/app/*"
          ]
        },
        "token": {
          "env": "STAAL_PACKAGE_KEY"
        }
      }
    }
  },
  "expect": {
    "failure": {
      "kind": "capability",
      "message": "is not a repository"
    },
    "requests": []
  }
}
