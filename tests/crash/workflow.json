{
  "entry": "handle",
  "inputs": {
    "message": "I was charged twice for order A1.",
    "order": { "id": "A1", "total": { "amount": "100.00", "currency": "USD" },
               "customer": { "name": "Ada", "email": "ada@example.com" } }
  },
  "grants": {
    "pay": { "cap": "payments.refund", "max": { "amount": "500.00", "currency": "USD" } },
    "mail": { "cap": "email.send" }
  },
  "model": { "provider": "script", "responses": [
    { "output": { "order_id": "A1", "amount": { "amount": "30.00", "currency": "USD" }, "reason": "double charge" }, "output_tokens": 40 },
    { "output": { "body": "Refunded a double charge on A1." }, "output_tokens": 12 }
  ] },
  "adapters": { "simulated": { "fail": [ { "cap": "email.send", "when_arg": "bounce@example.com" } ] } }
}
