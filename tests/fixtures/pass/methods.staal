// Methods with @blind receivers, named arguments, defaults and enums.
type Order { email: Text, name: Text }

enum Size {
    Small,
    Large { extra: Int },
}

fn Order.greeting(self @blind(email), formal: Bool = false) -> Text budget(calls: 2, tokens: 20) {
    if formal {
        return validate propose(Text, instruct: "Greet formally.", data: [self.name], tokens: 10)
    }
    return validate propose(Text, instruct: "Greet.", data: [self.name], tokens: 10)
}

fn Size.weight(self) -> Int {
    match self {
        Small => {
            return 1
        }
        Large { extra } => {
            return 2 + extra
        }
    }
}

fn f(order: Order @blind(email)) -> Text budget(calls: 2, tokens: 20) {
    return order.greeting(formal: true)
}

fn g(s: Size) -> Int {
    return s.weight() + Size.Small.weight()
}
