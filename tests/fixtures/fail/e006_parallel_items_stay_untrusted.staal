// expect: E006
// Each task is given an item of the list: a model's items stay untrusted in the
// tasks, so one cannot fill a parameter that must be trusted.
type Topics { items: List<Text, 3> }

fn ask(instruction: Text @trusted) -> Text budget(calls: 1, tokens: 300) {
    return validate propose(Text, instruct: instruction, tokens: 300)
}

fn run() -> List<Text, 3> budget(calls: 4, tokens: 1200) {
    let topics = validate propose(Topics, tokens: 300)
    return parallel(topics.items, ask)
}
