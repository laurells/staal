// expect: E101
// message: action a.b.go: parameter 'other' must be data; capabilities and secrets come through `needs`
capability a.b {
    needs http: cap net.http.post
    action go(t: Text, other: cap net.http.get) -> Text {
        let r = http.post("https://x.example/", t)
        return r.body
    }
}
