// expect: E101
// message: this `_` arm can never run: every variant is already matched
enum Payment {
    Pending,
    Paid { amount: Money, reference: Text },
    Refunded { amount: Money, reason: Text },
}

fn f(p: Payment) {
    match p {
        Pending => {}
        Paid { .. } => {}
        Refunded { .. } => {}
        _ => {}
    }
}
