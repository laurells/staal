// expect: E101
// message: cannot `set amount`
enum Payment {
    Pending,
    Paid { amount: Money, reference: Text },
    Refunded { amount: Money, reason: Text },
}

fn f(p: Payment) {
    match p {
        Paid { amount, .. } => {
            set amount = 1.00 NGN
        }
        _ => {}
    }
}
