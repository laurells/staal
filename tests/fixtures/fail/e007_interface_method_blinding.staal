// expect: E007
// Through an interface, the concrete method's blinding rules still hold.
interface Greeter {
    fn greet(self) -> Text
}

type Order { email: Text }

fn Order.greet(self) -> Text budget(calls: 1, tokens: 10) {
    return validate propose(Text, instruct: "Greet.", data: [self.email], tokens: 10)
}

fn hello<T: Greeter>(x: T) -> Text budget(calls: 1, tokens: 10) {
    return x.greet()
}

fn f(order: Order @blind(email)) -> Text budget(calls: 1, tokens: 10) {
    return hello(order)
}
