// expect: E007
// An arm that returns early decides whether the call after the match happens.
enum Payment {
    Pending,
    Paid { amount: Money, reference: Text },
    Refunded { amount: Money, reason: Text },
}
type Order { payment: Payment }

fn f(order: Order @blind(payment)) {
    match order.payment {
        Pending => {
            return
        }
        _ => {}
    }
    let s = propose(Text, instruct: "Say hello.", data: ["hello"], tokens: 10)
}
