// Runtime behaviour of `set`.
type Item { sku: Text, qty: Int }
type Note { text: Text }

fn count_in_stock(items: List<Item, 50>) -> Int {
    let n = 0
    for item in items {
        if item.qty > 0 {
            set n = n + 1
        }
    }
    return n
}

fn skus(items: List<Item, 50>) -> Text {
    let out = ""
    for item in items {
        if len(out) > 0 {
            set out = out + ", "
        }
        set out = out + item.sku
    }
    return out
}

// `set` changes the innermost variable of that name; an inner `let` of the same
// name is a different variable, gone at the end of its block.
fn shadowing() -> Text {
    let x = "outer"
    if true {
        let x = "inner"
        set x = "inner changed"
    }
    if true {
        set x = x + " changed"
    }
    return x
}

fn short_note(topic: Text) -> Text budget(calls: 3, tokens: 3000) {
    let note: Note = validate propose(Note, instruct: "Write a one-line note about the topic in the data.", data: [topic], tokens: 1000)
    repeat 2 {
        if len(note.text) <= 20 {
            break
        }
        set note = validate propose(Note, instruct: "Write a shorter one-line note about the topic in the data.", data: [topic], tokens: 1000)
    }
    return note.text
}

// An overflow in a `set` is a failure, and the old value is untouched.
fn grow(start: Int) -> Int {
    let n = start
    let r = try double(n)
    if r.ok {
        set n = 0
    }
    return n
}

fn double(n: Int) -> Int {
    let m = n
    set m = m * 2
    return m
}
