{
  "entry": "handle",
  "inputs": {
    "message": "I was charged twice for order A1.",
    "order": {
      "id": "A1",
      "total": {
        "amount": "1000.00",
        "currency": "USD"
      },
      "customer": {
        "name": "Ada",
        "email": "ada@example.com"
      }
    }
  },
  "grants": {
    "pay": {
      "cap": "payments.refund",
      "max": {
        "amount": "500.00",
        "currency": "USD"
      }
    },
    "mail": {
      "cap": "email.send"
    }
  },
  "model": {
    "provider": "script",
    "responses": [
      {
        "output": {
          "order_id": "A1",
          "amount": {
            "amount": "600.00",
            "currency": "USD"
          },
          "reason": "double charge"
        },
        "output_tokens": 40
      }
    ]
  },
  "expect": {
    "failure": "capability",
    "message_contains": "left of its 500.00 USD limit",
    "performed": [],
    "events": [
      "action_requested",
      "action_refused",
      "run_end"
