// `parallel`: results in the list's order, for more tasks than threads; nothing for
// nothing; generic and module functions; tasks inside tasks; the first failure by
// position.
import check

fn square(n: Int) -> Int {
    return n * n
}

fn first_of<T>(xs: List<T, 3>) -> T {
    return xs[0]
}

fn sum_squares(xs: List<Int, 5>) -> Int {
    return sum(parallel(xs, square))
}

fn fails_on(n: Int, bad: Int) -> Int {
    if n >= bad {
        fail("task \(n) failed")
    }
    return n
}

fn run_all(xs: List<Int, 6>, bad: Int) -> List<Int, 6> {
    return parallel(xs, fails_on, bad)
}

fn numbers(n: Int) -> List<Int, 50> {
    let xs: List<Int, 50> = []
    let i = 0
    repeat 50 {
        if i == n {
            break
        }
        set xs = append(xs, i)
        set i = i + 1
    }
    return xs
}

fn test_results_keep_the_list_order_with_more_tasks_than_threads() {
    let squares = parallel(numbers(40), square)
    check.int("count", len(squares), 40)
    let i = 0
    for s in squares {
        check.int("square of \(i)", s, i * i)
        set i = i + 1
    }
}

fn test_an_empty_list_runs_nothing() {
    let none_at_all: List<Int, 3> = []
    check.int("no results", len(parallel(none_at_all, square)), 0)
}

fn test_generic_functions_and_tasks_inside_tasks() {
    let firsts = parallel([["a", "b", "c"], ["d", "e", "f"]], first_of)
    check.text("first of each", join(firsts, ""), "ad")
    let sums = parallel([[1, 2, 3, 4, 5], [0, 0, 0, 0, 2]], sum_squares)
    check.int("nested", sums[0] + sums[1], 59)
}

fn test_a_module_function_runs_in_tasks() {
    // check.yes(what, got) for each item: all true, nothing fails.
    parallel(["a", "b"], check.yes, true)
    let r = try all_false()
    check.no("a failing task fails the whole", r.ok)
}

fn all_false() {
    parallel(["a", "b"], check.yes, false)
}

fn test_the_first_failure_by_position_is_the_failure() {
    // Items 3, 4 and 5 fail; every task runs, and it is item 3's failure.
    let r = try run_all([0, 1, 2, 3, 4, 5], 3)
    check.no("failed", r.ok)
    check.yes("item 3's failure: \(r.error)", ends_with(r.error, "task 3 failed"))
    let fine = try run_all([0, 1, 2], 3)
    check.yes("all pass", fine.ok)
}
