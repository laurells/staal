import sms.termii
import util.text as txt { Clean, clean }

fn notify(phone: Text, body: Text, http: cap net.http.post) -> Response {
    let m = termii.Message { to: phone, body: body }
    let c: Clean = clean(body)
    let d: txt.Clean = txt.clean(body)
    let same: termii.Message = m
    return termii.send(same, http)
}
