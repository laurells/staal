// A library capability: SMS through Termii (https://termii.com).
//
// A program that imports this file can ask for `cap termii.sms.send(only: [...], uses: N)`
// and call `sms.send(phone, text)`. It never sees the API key, the URL or the HTTP
// capability: the operator grants those to the library, in the run config's `needs`
// (RUNTIME.md section 13). `only` lists phone numbers, in the form `canonical` gives.

type Sms { to: Text, from: Text, sms: Text, type: Text, channel: Text, api_key: Text }
type SmsReply { message_id: Text }

capability termii.sms {
    needs http: cap net.http.post
    needs key: Secret
    // For example https://api.ng.termii.com: the base URL your Termii dashboard shows.
    needs base: Text
    // An approved sender ID.
    needs sender: Text

    // International format without '+' or spaces: "+234 801 234 5678" is "2348012345678".
    canonical(phone: Text) -> Text {
        return number(phone)
    }

    action send(to: Text @target, text: Text) -> Text {
        let sms = Sms { to: number(to), from: sender, sms: text, type: "plain", channel: "generic", api_key: "{secret}" }
        let r = http.post(base + "/api/sms/send", fill_secret(json(sms), key),
            [header("Content-Type", "application/json")])
        if r.status != 200 or not r.complete {
            fail("Termii answered " + json(r.status) + ": " + r.body)
        }
        let reply: SmsReply = validate parse(SmsReply, r.body)
        return reply.message_id
    }
}

fn number(phone: Text) -> Text {
    return replace(replace(replace(trim(phone), " ", ""), "-", ""), "+", "")
}
