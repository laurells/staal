// Send one SMS through Termii (https://termii.com). How to run it: examples/README.md.
//
// The API key is read from the environment and only ever placed in the request body,
// inside the template below. The capability can reach this one URL, once.

type Sms { to: Text, from: Text, sms: Text, type: Text, channel: Text, api_key: Text }
type SmsReply { message_id: Text, code: Text }

fn send(to: Text, text: Text, sender: Text, channel: Text, key: Secret,
    termii: cap net.http.post(only: ["https://api.ng.termii.com/api/sms/send"], uses: 1)) -> Text {
    let sms = Sms { to: to, from: sender, sms: text, type: "plain", channel: channel, api_key: "{secret}" }
    let r = termii.post("https://api.ng.termii.com/api/sms/send", fill_secret(json(sms), key),
        [header("Content-Type", "application/json")])
    if r.status != 200 or not r.complete {
        return "Termii answered " + json(r.status) + ": " + r.body
    }
    let reply: SmsReply = validate parse(SmsReply, r.body)
    return "sent, message id " + reply.message_id
}
