// A message to the customer, written by the caller, sent only to the phone number
// the app has for the customer.

import sms

type Contact { phone: Text }

fn main(customer: Text, database: Text, message: Text, db: cap db.sqlite.query, text: cap sms.messages.send(uses: 1)) -> Text {
    let contact: List<Contact, 1> = validate parse(List<Contact, 1>, db.query(database,
        "select phone from customers where id = ?", [customer]))
    if len(contact) == 0 {
        fail("this customer has no phone number")
    }
    let sent = text.send(contact[0].phone, message)
    return "Sent"
}
