{
  "name": "@staal/node",
  "version": "0.26.0",
  "description": "Staal, the programming language for agents, for Node.js: the staalc compiler and runtime, through its C interface",
  "keywords": [
    "staal",
    "agents",
    "ai-agents",
    "programming-language",
    "compiler",
    "capabilities"
  ],
  "license": "Apache-2.0 WITH LLVM-exception",
  "homepage": "https://laurells.github.io/staal/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laurells/staal.git",
    "directory": "node"
  },
  "bugs": "https://github.com/laurells/staal/issues",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "bin/",
    "README.md",
    "LICENSE",
    "NOTICE",
    "LICENSE-THIRD-PARTY.txt",
    "openai-agents.js",
    "openai-agents.d.ts",
    "langgraph.js",
    "langgraph.d.ts",
    "vercel-ai.mjs",
    "vercel-ai.d.mts",
    "claude-agent-sdk.mjs",
    "claude-agent-sdk.d.mts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "scripts": {
    "test": "node --test test/staal.test.mjs",
    "types": "tsc --noEmit -p test/tsconfig.json && tsc --noEmit -p test/tsconfig.esm.json"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./openai-agents": {
      "types": "./openai-agents.d.ts",
      "default": "./openai-agents.js"
    },
    "./langgraph": {
      "types": "./langgraph.d.ts",
      "default": "./langgraph.js"
    },
    "./vercel-ai": {
      "types": "./vercel-ai.d.mts",
      "import": "./vercel-ai.mjs"
    },
    "./claude-agent-sdk": {
      "types": "./claude-agent-sdk.d.mts",
      "import": "./claude-agent-sdk.mjs"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@openai/agents": ">=0.20.0",
    "@langchain/core": ">=1.2.18",
    "ai": ">=7.0.145",
    "@anthropic-ai/claude-agent-sdk": ">=0.3.304",
    "@modelcontextprotocol/sdk": ">=1.29.0"
  },
  "peerDependenciesMeta": {
    "@openai/agents": {
      "optional": true
    },
    "@langchain/core": {
      "optional": true
    },
    "ai": {
      "optional": true
    },
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  }
}
