// A text of n characters read 1000 times: its length in characters, and whether it
// holds a number, which it never does.
fn main(n: Int) -> Int {
    let t = ""
    let i = 0
    loop {
        if i >= n / 10 {
            break
        }
        set t = t + "abcdéfghij"
        set i = i + 1
    }
    let s = 0
    let j = 0
    loop {
        if j >= 1000 {
            break
        }
        set s = s + len(t)
        if contains(t, to_text(j)) {
            set s = s + 1
        }
        set j = j + 1
    }
    return s
}
