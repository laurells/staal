// A map of counts: n keys, from 1000 distinct ones, each counted.
fn main(n: Int) -> Int {
    let counts: Map<Int, Int, 1000> = [0: 0]
    let i = 0
    loop {
        if i >= n {
            break
        }
        let k = rem(i * 7919, 1000)
        match get(counts, k) {
            some(c) => { set counts = put(counts, k, c + 1) }
            none => { set counts = put(counts, k, 1) }
        }
        set i = i + 1
    }
    let s = 0
    for (k, v) in entries(counts) {
        set s = s + k * v
    }
    return s
}
